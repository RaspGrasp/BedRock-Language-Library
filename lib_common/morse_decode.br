fn morse_to_char(code) {
    if (code == 5)  { return 65; }
    if (code == 24) { return 66; }
    if (code == 26) { return 67; }
    if (code == 12) { return 68; }
    if (code == 2)  { return 69; }
    if (code == 18) { return 70; }
    if (code == 14) { return 71; }
    if (code == 16) { return 72; }
    if (code == 4)  { return 73; }
    if (code == 23) { return 74; }
    if (code == 13) { return 75; }
    if (code == 20) { return 76; }
    if (code == 7)  { return 77; }
    if (code == 6)  { return 78; }
    if (code == 15) { return 79; }
    if (code == 22) { return 80; }
    if (code == 29) { return 81; }
    if (code == 10) { return 82; }
    if (code == 8)  { return 83; }
    if (code == 3)  { return 84; }
    if (code == 9)  { return 85; }
    if (code == 17) { return 86; }
    if (code == 11) { return 87; }
    if (code == 25) { return 88; }
    if (code == 27) { return 89; }
    if (code == 28) { return 90; }
    return 63;
}
