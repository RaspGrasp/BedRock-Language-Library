fn print_sel(s) {
    s = s & 255;
    k_print_char(62);
    k_print_char(32);
    k_print_char(49 + s);
    k_nl();
}

fn print_run(s) {
    s = s & 255;
    k_print_char(82);
    k_print_char(85);
    k_print_char(78);
    k_print_char(32);
    k_print_char(49 + s);
    k_nl();
}

fn print_menu_word() {
