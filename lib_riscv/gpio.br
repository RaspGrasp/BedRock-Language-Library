root GPIO_OUT_W1TS    = 0x60004008;
root GPIO_OUT_W1TC    = 0x6000400C;
root GPIO_ENABLE_W1TS = 0x60004024;
root GPIO_IN          = 0x6000403C;
root IO_MUX_GPIO8     = 0x60009024;
root IO_MUX_GPIO9     = 0x60009028;
root LED_BIT          = 1 << 8;
root BOOT_BIT         = 1 << 9;

fn led_on() {
    poke(GPIO_OUT_W1TC, LED_BIT);
}

fn led_off() {
    poke(GPIO_OUT_W1TS, LED_BIT);
}

fn blink_feedback() {
    led_on();
    delay(60000);
    led_off();
}

fn boot_down() {
    let v = peek(GPIO_IN) & BOOT_BIT;
    if (v == 0) {
        return 1;
    }
    return 0;
}

fn gpio_init() {
    poke(IO_MUX_GPIO8, 0x1000);
    poke(IO_MUX_GPIO9, 0x1280);
    poke(GPIO_ENABLE_W1TS, LED_BIT);
    led_off();
}
