include "sys_x86";
include "mem_byte";

root SERIAL_FLAGS = 258;

fn serial_open(path) {
    return sys_open(path, SERIAL_FLAGS);
}

fn serial_read_byte(fd, buf) {
    poke_byte(buf, 0);
    let n = sys_read(fd, buf, 1);
    if (n > 0) {
        return peek_byte(buf);
    }
    return 0 - 1;
}

fn serial_wait_boot(loops) {
    let w = 0;
    while (w < loops) {
        w = w + 1;
    }
}
